{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antur.as/schemas/irish-generation-batch-v1.schema.json",
  "title": "An Turas deterministic Irish generation batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "batch_id",
    "created_at",
    "purpose",
    "voice_profile",
    "execution",
    "spend",
    "lines",
    "counts",
    "manifest_identity_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract": { "const": "irish_generation_batch" },
    "batch_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "voice_profile": { "$ref": "#/$defs/lockedVoiceProfile" },
    "execution": { "$ref": "#/$defs/execution" },
    "spend": { "$ref": "#/$defs/spend" },
    "lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/line" }
    },
    "counts": { "$ref": "#/$defs/counts" },
    "manifest_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "nullableString": {
      "type": ["string", "null"]
    },
    "lockedVoiceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "provider",
        "voice_name",
        "voice_id",
        "model_id",
        "language_code",
        "output_format",
        "voice_settings"
      ],
      "properties": {
        "id": { "const": "voice.irish-cultural-guide.eleven-v3.v1" },
        "revision": { "const": 1 },
        "provider": { "const": "ElevenLabs" },
        "voice_name": { "const": "Irish Cultural Guide" },
        "voice_id": { "const": "NPWroowF4phQhaPWjXPj" },
        "model_id": { "const": "eleven_v3" },
        "language_code": { "const": "ga" },
        "output_format": { "const": "mp3_44100_192" },
        "voice_settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "overrides"],
          "properties": {
            "mode": { "const": "provider_defaults" },
            "overrides": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provider_calls_allowed", "approved_by", "approved_at"],
      "properties": {
        "state": { "enum": ["draft", "approved", "closed"] },
        "provider_calls_allowed": { "type": "boolean" },
        "approved_by": { "$ref": "#/$defs/nullableString" },
        "approved_at": { "$ref": "#/$defs/nullableString" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "draft" } } },
          "then": {
            "properties": {
              "provider_calls_allowed": { "const": false },
              "approved_by": { "type": "null" },
              "approved_at": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "approved" } } },
          "then": {
            "properties": {
              "provider_calls_allowed": { "const": true },
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_at": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "closed" } } },
          "then": {
            "properties": {
              "provider_calls_allowed": { "const": false },
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner_id", "claimed_at", "lease_expires_at"],
      "properties": {
        "status": { "enum": ["unclaimed", "claimed", "released", "completed"] },
        "owner_id": { "$ref": "#/$defs/nullableString" },
        "claimed_at": { "$ref": "#/$defs/nullableString" },
        "lease_expires_at": { "$ref": "#/$defs/nullableString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unclaimed" } } },
          "then": {
            "properties": {
              "owner_id": { "type": "null" },
              "claimed_at": { "type": "null" },
              "lease_expires_at": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["claimed", "released", "completed"] } } },
          "then": {
            "properties": {
              "owner_id": { "type": "string", "minLength": 1 },
              "claimed_at": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "claimed" } } },
          "then": {
            "properties": {
              "lease_expires_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at"],
      "properties": {
        "status": { "enum": ["planned", "approved", "cancelled"] },
        "approved_by": { "$ref": "#/$defs/nullableString" },
        "approved_at": { "$ref": "#/$defs/nullableString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": {
            "properties": {
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_count", "max_attempts", "last_attempt_at", "next_retry_at"],
      "properties": {
        "attempt_count": { "type": "integer", "minimum": 0 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "last_attempt_at": { "$ref": "#/$defs/nullableString" },
        "next_retry_at": { "$ref": "#/$defs/nullableString" }
      }
    },
    "providerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider_request_id",
        "started_at",
        "completed_at",
        "reported_credits",
        "reported_characters"
      ],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "succeeded", "failed"] },
        "provider_request_id": { "$ref": "#/$defs/nullableString" },
        "started_at": { "$ref": "#/$defs/nullableString" },
        "completed_at": { "$ref": "#/$defs/nullableString" },
        "reported_credits": { "type": ["number", "null"], "minimum": 0 },
        "reported_characters": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "usageSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "used_credits", "remaining_credits"],
      "properties": {
        "captured_at": { "type": "string", "minLength": 1 },
        "used_credits": { "type": "number", "minimum": 0 },
        "remaining_credits": { "type": "number", "minimum": 0 }
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_cap",
        "estimate_basis",
        "credits_per_character",
        "estimated_batch_credits",
        "estimated_cumulative_credits",
        "actual_batch_credits",
        "actual_cumulative_credits",
        "usage_before",
        "usage_after",
        "cap_authorization"
      ],
      "properties": {
        "approved_cap": { "const": 25000 },
        "estimate_basis": {
          "const": "estimated_credits = Unicode character count × credits_per_character"
        },
        "credits_per_character": { "const": 1.0 },
        "estimated_batch_credits": { "type": "number", "minimum": 0 },
        "estimated_cumulative_credits": { "type": "number", "minimum": 0 },
        "actual_batch_credits": { "type": ["number", "null"], "minimum": 0 },
        "actual_cumulative_credits": { "type": ["number", "null"], "minimum": 0 },
        "usage_before": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/usageSnapshot" }]
        },
        "usage_after": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/usageSnapshot" }]
        },
        "cap_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "authorized_by", "authorized_at", "reason"],
          "properties": {
            "status": { "const": "removed" },
            "authorized_by": { "type": "string", "minLength": 1 },
            "authorized_at": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retriable", "occurred_at"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retriable": { "type": "boolean" },
        "occurred_at": { "type": "string", "minLength": 1 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_path", "sha256", "bytes", "duration_seconds"],
      "properties": {
        "output_path": { "type": "string", "minLength": 1 },
        "sha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "bytes": { "type": ["integer", "null"], "minimum": 1 },
        "duration_seconds": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "audioQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record"],
      "properties": {
        "status": { "enum": ["not_started", "pending", "passed", "flagged", "failed"] },
        "record": { "type": ["object", "null"] }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "member_ids",
        "normalized_text",
        "text_sha256",
        "inventory_slug",
        "estimated_characters",
        "estimated_credits",
        "capture_disposition",
        "claim",
        "request",
        "retry",
        "provider_result",
        "error",
        "audio",
        "audio_qa"
      ],
      "properties": {
        "line_id": { "type": "string", "minLength": 1 },
        "member_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "normalized_text": { "type": "string", "minLength": 1 },
        "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "inventory_slug": { "type": "string", "minLength": 1 },
        "estimated_characters": { "type": "integer", "minimum": 0 },
        "estimated_credits": { "type": "number", "minimum": 0 },
        "capture_disposition": { "const": "generated_unreviewed" },
        "claim": { "$ref": "#/$defs/claim" },
        "request": { "$ref": "#/$defs/request" },
        "retry": { "$ref": "#/$defs/retry" },
        "provider_result": { "$ref": "#/$defs/providerResult" },
        "error": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/error" }
          ]
        },
        "audio": { "$ref": "#/$defs/audio" },
        "audio_qa": { "$ref": "#/$defs/audioQa" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "member_references", "planned", "approved", "succeeded", "failed"],
      "properties": {
        "lines": { "type": "integer", "minimum": 0 },
        "member_references": { "type": "integer", "minimum": 0 },
        "planned": { "type": "integer", "minimum": 0 },
        "approved": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
